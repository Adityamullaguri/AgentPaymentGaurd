{
  "buildCommand": "cd apps/dashboard && npm install --include=dev && npm run build",
  "outputDirectory": "apps/dashboard/dist",
  "installCommand": "npm install --prefix apps/dashboard --include=dev",
  "rewrites": [
    {
      "source": "/admin-api/:path*",
      "destination": "/api/admin/:path*"
    },
    {
      "source": "/admin-events",
      "destination": "/api/events"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
